    {
      "_id": "req_window_down",
      "_type": "request",
      "parentId": "fld_admin",
      "name": "Force sliding window down",
      "description": "Forca o WindowStore (janela deslizante usada por regras como velocidade-pix) para o modo indisponivel, simulando degradacao. Requer que o servidor tenha sido iniciado com um WindowStore (nao disponivel no modo loadtest, que passa nil) -> 503 caso contrario.\n\n200: { \"window\": \"down\" }",
      "url": "{{ _.baseUrl }}/admin/window/down",
      "method": "POST",
