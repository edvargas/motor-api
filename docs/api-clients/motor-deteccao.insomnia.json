    {
      "_id": "req_submit_transaction",
      "_type": "request",
      "parentId": "fld_transactions",
      "name": "Submit transaction",
      "description": "Avalia uma transacao de forma sincrona atraves do pool de dispatch e do pipeline de deteccao.\n\nRespostas:\n- 200 com { \"suspicious\": false } quando nao ha alerta.\n- 200 com { \"suspicious\": true, \"alert\": {...} } quando uma regra dispara.\n- 200 com { \"status\": \"duplicate\", \"suspicious\": false } quando customer_id:transaction_id ja foi processado.\n- 400 quando o payload e invalido (campos obrigatorios ausentes, amount <= 0, channel desconhecido, captured_at ausente).\n- 500 em falha interna de processamento.",
      "url": "{{ _.baseUrl }}/transactions",
      "method": "POST",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"customer_id\": \"{{ _.customerId }}\",\n  \"transaction_id\": \"{{ _.transactionId }}\",\n  \"amount\": 150.50,\n  \"currency\": \"BRL\",\n  \"channel\": \"pix\",\n  \"device_id\": \"device-abc\",\n  \"geo\": {\n    \"country\": \"BR\",\n    \"lat\": -23.5505,\n    \"lon\": -46.6333\n  },\n  \"captured_at\": \"2026-09-01T12:00:00Z\"\n}"
      },
      "headers": [
        { "name": "Content-Type", "value": "application/json" }
      ],
      "parameters": [],
      "authentication": {},
      "metaSortKey": -4000,
      "isPrivate": false,
      "settingStoreCookies": true,
      "settingSendCookies": true,
      "settingDisableRenderRequestBody": false,
      "settingEncodeUrl": true,
      "settingRebuildPath": true,
      "settingFollowRedirects": "global"
    },
    {
      "_id": "req_submit_transaction_batch",
      "_type": "request",
      "parentId": "fld_transactions",
      "name": "Submit transaction batch",
      "description": "Avalia um lote de transacoes em paralelo (particionado por customer_id, preservando a ordem de submissao por cliente) e retorna um resumo agregado.\n\n200:\n{\n  \"total\": 2,\n  \"alerts\": 1,\n  \"duplicates\": 0,\n  \"partials\": 0,\n  \"latency_ms\": { \"p50\": 1.2, \"p95\": 3.4, \"p99\": 4.0 },\n  \"tps\": 950.5\n}\n\n400 quando o corpo nao e um JSON array valido.",
      "url": "{{ _.baseUrl }}/transactions/batch",
      "method": "POST",
      "body": {
        "mimeType": "application/json",
        "text": "[\n  {\n    \"customer_id\": \"cust-001\",\n    \"transaction_id\": \"tx-101\",\n    \"amount\": 200.00,\n    \"currency\": \"BRL\",\n    \"channel\": \"pix\",\n    \"device_id\": \"device-abc\",\n    \"geo\": { \"country\": \"BR\", \"lat\": -23.5505, \"lon\": -46.6333 },\n    \"captured_at\": \"2026-09-01T12:00:00Z\"\n  },\n  {\n    \"customer_id\": \"cust-001\",\n    \"transaction_id\": \"tx-102\",\n    \"amount\": 8000.00,\n    \"currency\": \"BRL\",\n    \"channel\": \"ted\",\n    \"device_id\": \"device-abc\",\n    \"geo\": { \"country\": \"BR\", \"lat\": -23.5505, \"lon\": -46.6333 },\n    \"captured_at\": \"2026-09-01T12:00:05Z\"\n  }\n]"
      },
      "headers": [
        { "name": "Content-Type", "value": "application/json" }
      ],
      "parameters": [],
      "authentication": {},
      "metaSortKey": -3000,
      "isPrivate": false,
      "settingStoreCookies": true,
      "settingSendCookies": true,
      "settingDisableRenderRequestBody": false,
      "settingEncodeUrl": true,
      "settingRebuildPath": true,
      "settingFollowRedirects": "global"
    },
